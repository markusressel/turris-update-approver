#!/bin/sh /etc/rc.common
# procd service of turris-update-approver (https://github.com/markusressel/turris-update-approver)

START=99
USE_PROCD=1

PROG=/usr/bin/turris-update-approver
CONF=/etc/turris-update-approver.json

start_service() {
	if [ ! -f "$CONF" ]; then
		echo "turris-update-approver: $CONF is missing" >&2
		return 1
	fi
	procd_open_instance
	# Started directly (shebang), so the log tag is turris-update-approver instead of python3.
	procd_set_param command "$PROG" --config "$CONF"
	procd_set_param file "$CONF"
	procd_set_param respawn 3600 30 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
